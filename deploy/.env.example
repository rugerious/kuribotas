# Copy to deploy/.env on the server (chmod 600). Never commit .env: it holds the tunnel's secret.
# Which build of main to run: "sha-" + the full commit hash (see the image's tags on GHCR).
KURIBOTAS_TAG=sha-0000000000000000000000000000000000000000
# The address the family uses. https from the start: it makes the session cookie Secure.
PUBLIC_URL=https://chat.example.com
# Cloudflare Zero Trust → Networks → Tunnels → (your tunnel) → install command → the token after --token.
TUNNEL_TOKEN=

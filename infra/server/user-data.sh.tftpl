#!/bin/bash
# First boot of the Kuribotas server (Amazon Linux 2023, ARM). Logs: /var/log/cloud-init-output.log
set -euo pipefail

# 1 GB of swap: the instance has 0.5 GB of memory, and a pull or an update must not run out.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=1024 status=none
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo "/swapfile none swap defaults 0 0" >> /etc/fstab
fi

dnf install -y docker
systemctl enable --now docker

# Docker Compose isn't packaged for Amazon Linux: the release binary, pinned and checked by its hash.
COMPOSE_VERSION=v5.6.1
COMPOSE_SHA256=42cfa75f51ad0ccf290bad37899e0038a8c10a0069e85233ecc1d53e3ff1347d
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL -o /tmp/docker-compose "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-aarch64"
echo "$${COMPOSE_SHA256}  /tmp/docker-compose" | sha256sum -c -
install -m 755 /tmp/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose

install -d -m 750 /opt/kuribotas
dnf install -y -q sqlite # for the backups' consistent copy

# deploy.sh (and everything else on the server) comes from GitHub at the commit of the image in
# /kuribotas/image-tag, so a new instance always gets the scripts that match its version.
if tag=$(aws ssm get-parameter --region ${region} --name /kuribotas/image-tag --query Parameter.Value --output text) &&
  curl -fsSL -o /opt/kuribotas/deploy.sh "https://raw.githubusercontent.com/rugerious/kuribotas/$${tag#sha-}/deploy/server/deploy.sh"; then
  chmod 700 /opt/kuribotas/deploy.sh
  /opt/kuribotas/deploy.sh || echo "deploy.sh failed: run it again through SSM"
else
  echo "no /kuribotas/image-tag yet: set it, then fetch and run deploy/server/deploy.sh through SSM"
fi
